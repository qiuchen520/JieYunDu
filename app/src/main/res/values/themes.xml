<?xml version="1.0" encoding="utf-8"?>
<!-- 文件：themes.xml
     职责：仅提供窗口级主题（浅色、无 ActionBar）。真正的视觉主题在 Compose 层（阶段 6）
     依赖：无
     协议：AGPL-3.0 -->
<resources>
    <style name="Theme.JieYunDu" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 背板浅色底色 #F5F5F7（浅色 Area 风），避免启动闪白/闪黑（细节由 Compose 的 GlassBackground 绘制） -->
        <item name="android:windowBackground">#FFF5F5F7</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
